# Copy to docker/claude/.env (same directory as docker-compose.yml)
# fill in the project name
# and add docker/claude/.env to your project's .gitignore.

COMPOSE_PROJECT_NAME=vo2-estimation-claude

# Optional: per-developer Context7 API key for the bundled context7
# MCP server (library docs search). Without it the anonymous tier
# applies — rate-limited per IP, shared behind office NAT.
# Get a free key at https://context7.com/dashboard (starts with
# 'ctx7sk-'). Use a personal free key, not a shared/paid org key —
# the value is readable from inside the Claude session.
CONTEXT7_API_KEY=
